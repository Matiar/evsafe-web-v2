# Firebase (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging (optional - web push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Odoo - server-side only (proxied via /api/odoo to avoid CORS)
ODOO_BASE_URL=
ODOO_DB=
ODOO_UID=
ODOO_USER_ID=
ODOO_PASSWORD=


# Site URL for OG metadata (production)
NEXT_PUBLIC_SITE_URL=https://evehiclesafe.com

# Firebase Admin SDK (optional � server-side)
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-admin.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

