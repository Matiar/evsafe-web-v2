rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }

    function isNotDisabled() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'common' &&
        !('disabled' in request.resource.data);

      allow update: if isSignedIn() && isNotDisabled() && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled'])) ||
        (isAdmin() &&
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'disabled']))
      );

      allow delete: if false;

      match /products/{serial} {
        allow read, write: if isSignedIn() && isNotDisabled() && request.auth.uid == userId;
      }

      match /posts/{postId} {
        allow read, write: if isSignedIn() && isNotDisabled() && request.auth.uid == userId;
      }
    }

    match /post_likes/{postId} {
      allow read: if isSignedIn() && isNotDisabled();
      allow write: if isSignedIn() && isNotDisabled();
    }
  }
}
